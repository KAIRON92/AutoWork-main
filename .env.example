# AutoWork SaaS environment template
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Database configuration (PostgreSQL)
POSTGRES_USER=autowork
POSTGRES_PASSWORD=autoworkpass
POSTGRES_DB=autowork_db
DATABASE_URL="postgresql://autowork:autoworkpass@localhost:5432/autowork_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate unique values; never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret

# Required for real pCloud and provider credential storage.
# Base64-encoded 32-byte AES-256-GCM key.
# Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PCLOUD_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# pCloud integration
PCLOUD_DEFAULT_PROVIDER=pcloud
PCLOUD_ALLOW_MOCK=false
PCLOUD_API_URL=https://api.pcloud.com
PCLOUD_API_HOST=https://api.pcloud.com
PCLOUD_CLIENT_ID=replace-with-pcloud-app-client-id
PCLOUD_CLIENT_SECRET=replace-with-pcloud-app-client-secret
PCLOUD_ACCESS_TOKEN=
PCLOUD_DEFAULT_FOLDER_ID=0
PCLOUD_REDIRECT_URI=http://localhost:4000/api/v1/pcloud/accounts/oauth/callback

# Email provider integration
# Real providers must be authenticated. Fake provider is disabled unless explicitly opted into for non-production tests.
EMAIL_DEFAULT_PROVIDER=
EMAIL_ALLOW_FAKE=false

# Gmail / Google Workspace OAuth (required only when Gmail is enabled)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/email/accounts/gmail/callback

WEBSOCKET_PORT=4001
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
