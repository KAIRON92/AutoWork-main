{
  "name": "autowork-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cd frontend && npm run build",
    "worker:campaign": "ts-node -r dotenv/config workers/campaign.worker.entry.ts",
    "worker:pcloud": "ts-node -r dotenv/config workers/pcloud-share.worker.entry.ts",
    "worker:email": "ts-node -r dotenv/config workers/email-dispatch.worker.entry.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "5.8.7",
    "dotenv": "16.4.5",
    "ioredis": "5.3.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.11.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^5.22.0",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  }
}
